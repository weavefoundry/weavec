# WeaveC follows the LLVM coding style since it is built on Clang/LLVM.
# See docs/development.md for the full set of conventions.
---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 80
IndentWidth: 2
UseTab: Never
PointerAlignment: Right
AlwaysBreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
InsertNewlineAtEOF: true
QualifierAlignment: Left
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # The header corresponding to this source file (handled by IncludeIsMainRegex).
  # Project headers, and local headers in the same directory.
  - Regex: '^"weavec/'
    Priority: 1
  - Regex: '^"[^/]+"$'
    Priority: 1
  # Clang headers.
  - Regex: '^"clang/'
    Priority: 2
  # LLVM headers.
  - Regex: '^"llvm/'
    Priority: 3
  # Third-party headers.
  - Regex: '^<(gtest|gmock)/'
    Priority: 4
  # C system headers.
  - Regex: '^<[a-z_]+\.h>'
    Priority: 5
  # C++ standard library.
  - Regex: '^<[a-z_]+>'
    Priority: 6
  - Regex: '.*'
    Priority: 7
IncludeIsMainRegex: '(Test)?$'
---
Language: Json
BasedOnStyle: LLVM
...
