{
  "schema": "weavec-corpus-injections",
  "version": 1,
  "_comment": [
    "Injected bugs for gate G12 (RFC 0030, section 17.5): scripts/corpus-gate.py --inject",
    "applies each patch to a copy of the config's pinned checkout and checks that the bug",
    "is reported at `file`:`line` (the line that carries the INJECTED comment).",
    "`expect.ids` (+ `severity`: error, warning or any) is met by a diagnostic with one of",
    "the ids at that line; `expect.trap` (+ `run`) by a report-mode check failure with that",
    "template at that line while `run` executes in the built copy. An entry with both is met",
    "by either. `mode` is unit (the patched file alone) or whole-program (weavec",
    "--whole-program over the config's files, and a weavec-cc link where the config has",
    "`link`). `required` entries must be reported for G12 to pass; `dossier` records what",
    "the v0.10.0 measurement found (caught or missed) where it measured the same bug."
  ],
  "injections": [
    {
      "id": "sds-uaf-sdsfree",
      "config": "sds",
      "patch": "sds/uaf-sdsfree.patch",
      "file": "sds.c",
      "line": 168,
      "expect": {
        "ids": [
          "use-after-free"
        ],
        "severity": "any"
      },
      "mode": "unit",
      "description": "writes the string after sdsfree released its header allocation (s_free of s - header)",
      "dossier": "caught"
    },
