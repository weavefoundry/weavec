{
  "name": "weavec-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare:content && astro dev",
    "build": "npm run prepare:content && astro check && astro build && node scripts/check-site.mjs",
    "preview": "astro preview",
    "check": "npm run prepare:content && astro check",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"{src,pages,scripts,tests}/**/*.{astro,css,mjs,ts,md,mdx}\" \"*.{mjs,json,ts}\" \"data/*.json\"",
    "format:check": "prettier --check \"{src,pages,scripts,tests}/**/*.{astro,css,mjs,ts,md,mdx}\" \"*.{mjs,json,ts}\" \"data/*.json\""
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "astro": "7.3.2",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "cheerio": "^1.2.0",
    "github-slugger": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^7.0.2"
  }
}
